{
  "name": "web-publisher",
  "version": "1.0.0",
  "description": "Un blog moderno al estilo wordpress usando PHP, MySQL y Tailwind CSS",
  "main": "public/index.php",
  "scripts": {
    "build:css": "npx tailwindcss -i input.css -o public/css/styles.css --minify",
